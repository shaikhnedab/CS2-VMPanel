              <div class="row">
                <% for(let i=0; i < serverArray.length;i++){%>
                <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12">
                  <div class="card vmp-product">
                    <div class="card-body">
                      <p class="eyebrow">VIP · <%=serverArray[i].vip_days%> days</p>
                      <h4 class="card-title truncate" title="<%=serverArray[i].server_name%>"><%=serverArray[i].server_name || 'Unnamed server'%></h4>
                      <div class="vmp-price tnum"><%=serverArray[i].vip_price ? serverArray[i].vip_price + ' ' + serverArray[i].vip_currency : 'Price on request'%></div>
                      <div class="vmp-perks">
                        <%if(serverArray[i].server_ip && serverArray[i].server_port){%>
                        <a class="vmp-badge ok" href="<%='steam://connect/'+serverArray[i].server_ip+':'+serverArray[i].server_port%>"><span class="vmp-dot pulse" aria-hidden="true"></span>Join server</a>
                        <%}%>
                      </div>
                    </div>
                    <div class="card-footer">
                      <div class="vmp-paypal-slot" id="<%= slotId('buy', serverArray[i].tbl_name, i) %>" data-payload="<%= encodeURIComponent(JSON.stringify(serverArray[i])) %>" data-buytype="newPurchase"></div>
                      <%if(payuActive && panelSetting.platform_currency==="INR"){%>
                      <button type="button" class="btn btn-success btn-block" data-checkout data-gateway="payu" data-payload="<%= encodeURIComponent(JSON.stringify(serverArray[i])) %>" data-buytype="newPurchase" aria-label="Buy with PayU">
                        <img src="./images/payumoney.png" height="20" width="76" alt="PayU">
                      </button>
                      <%}%>
                      <%if(razorpayActive && panelSetting.platform_currency==="INR"){%>
                      <button type="button" class="btn btn-success btn-block" data-checkout data-gateway="razorpay" data-payload="<%= encodeURIComponent(JSON.stringify(serverArray[i])) %>" data-buytype="newPurchase" aria-label="Buy with Razorpay">
                        <img src="./images/razorpay.svg" height="20" width="76" alt="Razorpay">
                      </button>
                      <%}%>
