                      <%if(payuActive && panelSetting.platform_currency==="INR"){%>
                      <button type="button" class="btn btn-success btn-block" data-checkout data-gateway="payu" data-payload="<%= encodeURIComponent(JSON.stringify(srv)) %>" data-buytype="renewPurchase" aria-label="Renew with PayU">
                        <img src="./images/payumoney.png" height="18" width="68" alt="PayU">
                      </button>
                      <%}%>
                      <%if(razorpayActive && panelSetting.platform_currency==="INR"){%>
                      <button type="button" class="btn btn-success btn-block" data-checkout data-gateway="razorpay" data-payload="<%= encodeURIComponent(JSON.stringify(srv)) %>" data-buytype="renewPurchase" aria-label="Renew with Razorpay">
                        <img src="./images/razorpay.svg" height="18" width="68" alt="Razorpay">
                      </button>
                      <%}%>
                      <%}else{%>
                      <span class="vmp-badge">No renewal needed</span>
                      <%}%>
                    </td>
                  </tr>
                  <%}}%>
                </tbody>
              </table>
