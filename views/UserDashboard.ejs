                aria-controls="serverVip" aria-selected="true"><i class="material-icons" aria-hidden="true">dns</i> Servers</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" id="serverBundles-tab" data-toggle="tab" href="#serverBundles" role="tab"
                aria-controls="serverBundles" aria-selected="false"><i class="material-icons" aria-hidden="true">local_offer</i>
                Bundles &amp; offers</a>
            </li>
          </ul>
        </div>
        <div class="card-body">
