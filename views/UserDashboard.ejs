<!-- crypto script needed for payu (sometimes it gives error loading this script from sdk so adding it manually) -->

<script defer src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/3.1.9-1/crypto-js.js"></script>

<!-- Paypal SDK Settings start -->
<script>
  var paypalActive = <%=paypalActive%>;
  // Each server/bundle row is priced in its own currency; the panel setting is
  // only the default for rows that never declared one.
  window.vmpPlatformCurrency = "<%=panelSetting.platform_currency%>";
  window.vmpProductCurrency = function (serverData) {
    return ((serverData && serverData.vip_currency) || window.vmpPlatformCurrency || '').toUpperCase();
  };
  // Razorpay and PayU settle in INR only, so they are offered per-card on that
  // card's currency — not on the panel currency.
  window.vmpGatewaySupportsCurrency = function (gateway, currency) {
    var cur = String(currency || '').toUpperCase();
    if (cur !== 'USD' && cur !== 'INR') return false;
    if (gateway === 'payu' || gateway === 'razorpay') return cur === 'INR';
    return true;
  };
  // Decimal places of the currency's smallest sub-unit, so the client can
  // convert an amount_due back to major units without assuming 2 decimals.
  window.vmpCurrencyExponent = function (currency) {
    var zero = ['BIF','CLP','DJF','GNF','ISK','JPY','KMF','KRW','PYG','RWF','UGX','VND','VUV','XAF','XOF','XPF'];
    var three = ['BHD','IQD','JOD','KWD','OMR','TND'];
    var cur = String(currency || '').toUpperCase();
    if (zero.indexOf(cur) !== -1) return 0;
    if (three.indexOf(cur) !== -1) return 3;
    return 2;
  };
</script>
