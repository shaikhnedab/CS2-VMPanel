                    </div>
                    <button type="button" class="btn btn-info" id="vmpGiftVerifyBtn" onclick="vmpVerifyGiftRecipient()">Verify receiver</button>
                  </div>
                  <small class="text-muted">Accepts profile links, STEAM_1:X:Y, SteamID64, and [U:1:N]. Gifts cannot renew, and the receiver must not already hold VIP there.</small>
                  <div id="vmpGiftReceiverPreview" style="display:none;margin-top:12px" aria-live="polite"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
