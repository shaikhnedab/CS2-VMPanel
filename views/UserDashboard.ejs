                    <td><%- row.type===0 ? '<span class="vmp-badge violet">VIP</span>' : row.type===1 ? '<span class="vmp-badge info">Admin</span>' : '<span class="vmp-badge">NA</span>' %></td>
                    <td class="mono tnum"><%=row.created_at ? dateFormatter(row.created_at) : 'NA'%></td>
                    <td class="mono tnum"><%=row.expireStamp ? EpocToDate(row.expireStamp) : '—'%></td>
                    <td><%- row.expireStamp ? expiryBadge(remainingDays(row.expireStamp)) : (row.type===1 ? '<span class="vmp-badge info">Permanent</span>' : '<span class="vmp-badge">NA</span>') %></td>
