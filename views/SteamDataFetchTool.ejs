<div class="col-12">
  <div class="card">
    <div class="card-header" style="display:flex;align-items:center;gap:14px">
      <div class="vmp-fetch-id" id="dp_div">
        <i class="material-icons">person</i>
      </div>
      <div class="vmp-fetch-meta">
        <div class="vmp-fetch-name" id="display_name">Steam profile lookup</div>
        <div class="vmp-fetch-id-text" id="display_steamId">Fetch details to auto-fill the forms below</div>
      </div>
    </div>
    <div class="card-body">
      <form onsubmit="return false">
        <div class="vmp-fetch-form">
          <div class="form-group bmd-form-group">
            <input type="url" name="steam_URL" class="form-control" id="steam_URL" required
              placeholder="Paste user's Steam profile URL…" autocomplete="off">
          </div>
          <button type="button" onclick="profileUrlToDataFetcher($('#steam_URL').val())"
            class="btn btn-success">Fetch data</button>
        </div>
      </form>
    </div>
  </div>
</div>
