<%

function getPageHeading(route){
  let heading=""
switch (route) {
  case "/dashboard":
    heading = "Dashboard - "+panelSetting.community_name;
    break;
  case "/mydashboard":
    heading = "VIP Store - "+panelSetting.community_name;
    break;
  case "/managevip":
    heading = "Manage VIPs - "+panelSetting.community_name;
    break;
  case "/manageadmin":
    heading = "Manage Admins - "+panelSetting.community_name;
    break;
  case "/panelsetting":
    heading = "Panel Settings - "+panelSetting.community_name;
    break;
  case "/salesrecord":
    heading = "Sales Records - "+panelSetting.community_name;
    break;
  case "/auditlogs":
    heading = "Audit Logs - "+panelSetting.community_name;
    break;
  case "/login":
    heading = "Login - "+panelSetting.community_name;
    break;
  default:
    heading = "VMPanel - "+panelSetting.community_name;
}
return heading
}
%>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <link rel="apple-touch-icon" sizes="76x76" href="./images/icon.png">
  <link rel="icon" type="image/png" href="./images/favicon.ico">
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
  <meta name="theme-color" content="#0a0d14" id="vmpThemeColor" />
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <title>VMP — <%= getPageHeading(currentURL) %></title>
  <meta content='width=device-width, initial-scale=1.0, shrink-to-fit=no'
    name='viewport' />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" type="text/css"
    href="https://fonts.googleapis.com/css?family=Inter:400,500,600,700,800|Material+Icons" />
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/latest/css/font-awesome.min.css">
  <link href="./css/material-dashboard.css" rel="stylesheet" />
  <link href="./css/nova-tokens.css?v=4" rel="stylesheet" />
  <link href="./css/vmp-design-system.css?v=4" rel="stylesheet" />

  <script src="./js/theme/jquery.min.js"></script>
  <script src="./js/theme/popper.min.js"></script>
  <script src="./js/theme/bootstrap-material-design.min.js"></script>
  <script src="./js/theme/bootstrap-notify.js"></script>
  <script src="./js/theme/perfect-scrollbar.jquery.min.js"></script>
  <script src="./js/theme/material-dashboard.js"></script>
  <script>
    window.VMP_ROLE = {
      admin: <%= sessionToken ? 'true' : 'false' %>,
      superAdmin: <%= (adminType === 1) ? 'true' : 'false' %>,
      steam: <%= sessionSteamId ? 'true' : 'false' %>
    };
  </script>
  <script>
    try {
      if (localStorage.getItem('vmp-theme') === 'light') {
        document.documentElement.classList.add('vmp-light-pre');
      }
    } catch (e) {}
    function vmpToggleTheme() {
      var light = document.body.classList.toggle('vmp-light');
      try { localStorage.setItem('vmp-theme', light ? 'light' : 'dark'); } catch (e) {}
      var meta = document.getElementById('vmpThemeColor');
      if (meta) meta.setAttribute('content', light ? '#eef1f8' : '#0a0d14');
    }
    document.addEventListener('DOMContentLoaded', function () {
      try {
        if (localStorage.getItem('vmp-theme') === 'light') {
          document.body.classList.add('vmp-light');
          var meta = document.getElementById('vmpThemeColor');
          if (meta) meta.setAttribute('content', '#eef1f8');
        }
      } catch (e) {}
    });
  </script>

</head>

<body class="dark-edition" data-theme="<%= (panelSetting && panelSetting.color_theme) || 'primary' %>">
  <a class="skip-link" href="#vmpMain">Skip to main content</a>
  <div id="vmpNavScrim" onclick="vmpToggleNav(false)"></div>
  <%if(defaultCredWarning){%>
  <div class="vmp-default-cred-alert" role="alert">
    <i class="material-icons" aria-hidden="true">warning_amber</i>
    <span>You are signed in with the default <code>admin</code> account. Change its password before making this panel public.</span>
    <a class="btn btn-warning btn-sm" href="/panelsetting">Change password</a>
    <button type="button" onclick="this.parentElement.remove()" aria-label="Dismiss warning">&times;</button>
  </div>
  <%}%>
  <div class="wrapper ">
    <div class="sidebar"
      data-color="<%=panelSetting.color_theme=='primary'?'purple':panelSetting.color_theme=='danger'?'danger':panelSetting.color_theme=='success'?'green':panelSetting.color_theme=='warning'?'orange':panelSetting.color_theme=='info'?'azure':''%>"
      data-background-color="black">
      <div class="logo">
        <a href="/" class="simple-text logo-normal">
          <img class="img" height="42px" src="./images/icon.png" alt="CS2-VMPanel logo" id="icon_logo_id">
          <span id="text_logo_id">CS2-VMPanel</span>
        </a>
        <button id="vmpNavClose" onclick="vmpToggleNav(false)" aria-label="Close navigation menu">
          <i class="material-icons" aria-hidden="true">close</i>
        </button>
      </div>
      <div class="sidebar-wrapper">
        <ul class="nav">
          <li class="nav-item <%= (currentURL=='/dashboard' || currentURL=='/' ?'active':'') %>">
            <a class="nav-link" href="/dashboard">
              <i class="material-icons">grid_view</i>
              <p>Dashboard</p>
            </a>
          </li>
          <%if(sessionSteamId){%>
          <li class="nav-item <%= (currentURL=='/mydashboard'?'active':'') %>">
            <a class="nav-link" href="/mydashboard">
              <i class="material-icons">storefront</i>
              <p>VIP Store</p>
            </a>
          </li>
          <%}%>
          <%if(sessionToken){%>
          <li class="nav-item <%= (currentURL=='/managevip'?'active':'') %>">
            <a class="nav-link" href="/managevip">
              <i class="material-icons">stars</i>
              <p>Manage VIP</p>
            </a>
          </li>
          <li class="nav-item <%= (currentURL=='/manageadmin'?'active':'') %>">
            <a class="nav-link" href="/manageadmin">
              <i class="material-icons">admin_panel_settings</i>
              <p>Manage Admin</p>
            </a>
          </li>
          <%if(adminType===1){%>
          <li class="nav-item <%= (currentURL=='/salesrecord'?'active':'') %>">
            <a class="nav-link" href="/salesrecord">
              <i class="material-icons">payments</i>
              <p>Sales</p>
            </a>
          </li>
          <li class="nav-item <%= (currentURL=='/auditlogs'?'active':'') %>">
            <a class="nav-link" href="/auditlogs">
              <i class="material-icons">manage_history</i>
              <p>Audit Logs</p>
            </a>
          </li>
          <%}%>
          <%if((adminType===1)||(panelSetting.normiadmin_settings==1 && adminType===0)){%>
          <li class="nav-item <%= (currentURL=='/panelsetting'?'active':'') %>">
            <a class="nav-link" href="/panelsetting">
              <i class="material-icons">tune</i>
              <p>Settings</p>
            </a>
          </li>
          <%}}%>
          <%if(sessionToken||sessionSteamId){%>
          <li class="nav-item">
            <a class="nav-link" href="/logout">
              <i class="material-icons">logout</i>
              <p>Logout</p>
            </a>
          </li>
          <%}else{%>
          <li class="nav-item <%= (currentURL=='/login'?'active':'') %>">
            <a class="nav-link" href="/login">
              <i class="material-icons">login</i>
              <p>Login</p>
            </a>
          </li>
          <%}%>
        </ul>
      </div>
    </div>

    <div class="main-panel">
      <!-- Navbar -->
      <nav class="navbar navbar-expand-lg navbar-transparent navbar-absolute fixed-top " id="navigation-example">
        <div class="container-fluid">
          <div class="navbar-wrapper">
            <a class="navbar-brand" href="javascript:void(0)"><%= getPageHeading(currentURL) %></a>
      </div>

      <button class="navbar-toggler" type="button" data-toggle="collapse" aria-controls="navigation-index"
        aria-expanded="false" aria-label="Toggle navigation" data-target="#navigation-example">
        <span class="sr-only">Toggle navigation</span>
        <span class="navbar-toggler-icon icon-bar"></span>
        <span class="navbar-toggler-icon icon-bar"></span>
        <span class="navbar-toggler-icon icon-bar"></span>
      </button>
      <button id="vmpNavToggle" onclick="vmpToggleNav()" aria-label="Open navigation menu">
        <i class="material-icons">menu</i>
      </button>

      <div class="vmp-top-actions">
        <a class="nav-link" href="javascript:void(0)" id="vmpPaletteBtn" onclick="vmpTogglePalette(true)" title="Commands (Ctrl/⌘+K)" aria-label="Open command palette">
          <i class="material-icons" aria-hidden="true">terminal</i>
        </a>
        <a class="nav-link" href="javascript:void(0)" id="vmpThemeToggle" onclick="vmpToggleTheme()" title="Toggle light / dark mode" aria-label="Toggle light or dark mode">
          <i class="material-icons" aria-hidden="true">brightness_6</i>
        </a>
      </div>

      <div class="collapse navbar-collapse justify-content-end">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="<%= sessionToken?'dashboard':sessionSteamId?'mydashboard':'javascript:void(0)'%>">
              <span class="vmp-user-chip">
                <span class="vmp-avatar"><%= ((sessionToken&&adminName)||(sessionSteamId&&steamName)||'G').toString().trim().charAt(0).toUpperCase() %></span>
                <span class="d-lg d-md-block">
                  <%if(sessionToken){%>
                  <%="Admin · "+adminName%>
                  <%}else if (sessionSteamId){%>
                  <%=steamName%>
                  <%}else{%>
                  Guest
                  <%}%>
                </span>
              </span>
            </a>
          </li>
        </ul>
      </div>
    </div>
    </nav>
    <!-- End Navbar -->

<!-- utils.js (upstream branding lock + logo hotlink) removed in this fork -->
