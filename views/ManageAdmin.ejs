<%- include('Header.ejs') %>

<div class="content">
  <div class="container-fluid">
    <div class="row">

      <%- include('SteamDataFetchTool.ejs') %>

      <div class="col-md-6">
        <div class="card">
          <div class="card-header card-header-<%=panelSetting.color_theme%>">
            <h4 class="card-title">Add Admin</h4>
            <p class="card-category">Add a new admin to a server</p>
          </div>
          <div class="card-body" style="min-height:360px;" id="addAdminDiv">
            <form id="myForm_addAdmin">
              <div class="row">
                <div class="col-md-12">
                  <div class="form-group bmd-form-group">
                    <label class="bmd-label-floating">Steam ID</label>
                    <input id="steamId_add" type="text" class="form-control" required>
                  </div>
                  <div class="form-group bmd-form-group">
                    <label class="bmd-label-floating">User name</label>
                    <input id="name_add" type="text" class="form-control" required>
                  </div>
                  <div class="form-group bmd-form-group">
                    <label class="bmd-label-floating">Immunity level</label>
                    <input id="immunity_admin" type="number" class="form-control" value="0" required>
                  </div>
                  <div class="form-group bmd-form-group">
                    <label class="vmp-field-label">Select Servers to add in</label>
                    <div class="vmp-check-grid">
                      <% if(serverList) {%>
                      <% for(let i=0; i < serverList.length; i++) { %>
                      <div class="form-check">
                        <label class="form-check-label">
                          <input class="form-check-input" type="checkbox" name="server_add"
                            value="<%=serverList[i].tbl_name%>">
                          <%=serverList[i].server_name%>
                          <span class="form-check-sign">
                            <span class="check"></span>
                          </span>
                        </label>
                      </div>
                      <%}}%>
                      <% if(!serverList || !serverList.length) {%>
                      <span class="vmp-badge warn">No servers yet — add one in Panel Settings</span>
                      <%}%>
                    </div>
                  </div>
                </div>
              </div>
              <button type="button" onclick="addNewAdminajax()" class="btn btn-success pull-right">Add Admin</button>
              <div class="clearfix"></div>
            </form>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card">
          <div class="card-header card-header-<%=panelSetting.color_theme%>">
            <h4 class="card-title">Admin access flags</h4>
            <p class="card-category">Tick the flags this admin gets</p>
          </div>
          <div class="card-body row scroller" style="height:360px;overflow: auto;" id="style-4">
            <div class="col-md-12">
              <label class="">Admin Levels</label>
              <div class="table-responsive">
                <table class="table">
                  <thead>
                    <tr>
                    <th scope="col">Use</th>
                    <th scope="col">Name</th>
                    <th scope="col">Flag</th>
                    <th scope="col">Purpose</th>
                    </tr>
                  </thead>
                  <%- include('TbodyAdminFlags.ejs') %>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-12">
        <div class="card">
          <div class="card-header card-header-<%=panelSetting.color_theme%>">
            <h4 class="card-title" id="manageCardTitle">View and Manage Admin</h4>
            <p class="card-category">Select a server to view the list</p>
          </div>
          <div class="card-body">
            <div class="row align-items-center">
              <div class="col-lg-4 col-md-12 mb-2">
                <div class="dropdown server-picker">
                  <button class="btn btn-primary dropdown-toggle" type="button" id="dropdownMenuButton"
                    data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    Select Server
                  </button>
                  <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                    <% if(serverList) {%>
                    <% for(let i=0; i < serverList.length; i++) { %>
                    <button type="button" class="dropdown-item" onclick="getAdminTableListing('<%=serverList[i].tbl_name%>','<%=serverList[i].server_name%>')"> <%=serverList[i].server_name%> </button>
                    <%}}%>
                  </div>
                </div>
              </div>
              <div class="col-lg-8 col-md-12">
                <input type="hidden" id="hiddenServerTableName" name="hiddenServerTableName" value=""
                  autocomplete="off">
                <div class="vmp-searchbar">
                  <input type="text" class="form-control" placeholder="Search admins…" id="adminSearchInput" aria-label="Search admins">
                  <button type="button" class="btn btn-info btn-fab" onclick="getAdminTableListingSearch()" aria-label="Search">
                    <i class="material-icons" aria-hidden="true">search</i>
                  </button>
                  <button type="button" class="btn btn-default btn-fab" onclick="resetSearchAndTable()" aria-label="Clear search">
                    <i class="material-icons" aria-hidden="true">clear</i>
                  </button>
                </div>
              </div>
            </div>
            <hr />
            <div class="table-responsive scroller" style="max-height:400px;overflow: auto;" id="style-4">
              <table class="table " id="manageVipTable">
                <thead>
                  <tr>
                  <th scope="col">Steam ID</th>
                  <th scope="col">Name</th>
                  <th scope="col">Flags</th>
                  <th scope="col">Server</th>
                  <th scope="col"><span class="sr-only">Actions</span></th>
                  </tr>
                </thead>
                <tbody id="manageVipTableBody">
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<%- include('Footer.ejs') %>

<script src="./js/ManageAdmin.js"></script>
<script src="./js/customConfirm.js"></script>
<script src="./js/notifications.js"></script>
<script src="./js/steamIdFinder.js"></script>
<script src="./js/steamIdOperations/BigInteger.min.js"></script>
<script src="./js/steamIdOperations/steamIDconverter.js"></script>