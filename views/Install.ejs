<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
  <meta name="theme-color" content="#0a1120" />
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title>Install — CS2-VMPanel</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" type="text/css"
    href="https://fonts.googleapis.com/css?family=Space+Grotesk:wght@400;500;600;700|IBM+Plex+Mono:wght@400;500;600|Material+Icons" />
  <!-- Same design system as the panel itself: tokens + components, so the
       installer cannot drift away from the rest of the UI. -->
  <link href="/css/material-dashboard.css" rel="stylesheet" />
  <link href="/css/nova-tokens.css?v=19" rel="stylesheet" />
  <link href="/css/vmp-design-system.css?v=19" rel="stylesheet" />
  <style>
    /* Layout only — colors, type and controls come from the shared sheets. */
    .inst-wrap {
      max-width: 780px;
      margin: 0 auto;
    }

    .inst-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px 18px;
    }

    /* Material Dashboard puts its own margins on .form-group and
       .vmp-field-label, which stacks up with the grid gap. The grid owns the
       rhythm here, so zero them out. */
    .inst-grid .form-group {
      margin: 0 !important;
      padding: 0;
    }

    .inst-grid .vmp-field-label {
      margin: 0 0 6px !important;
      display: block;
    }

    .inst-grid .form-control {
      margin: 0 !important;
    }

    .inst-grid .full {
      grid-column: 1 / -1;
    }

    .inst-section {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 4px 0 -2px;
      color: var(--muted);
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: 0.09em;
      text-transform: uppercase;
    }

    .inst-section::after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--line);
    }

    .inst-note {
      display: none;
      align-items: flex-start;
      gap: 9px;
      margin-bottom: 18px;
      padding: 12px 14px;
      border-radius: var(--r-sm);
      border: 1px solid var(--line-strong);
      background: var(--inset);
      font-size: var(--text-md);
    }

    .inst-note.show {
      display: flex;
    }

    .inst-note .material-icons {
      font-size: 18px;
      flex: 0 0 auto;
    }

    .inst-note.ok {
      border-color: var(--respawn);
      color: var(--respawn);
    }

    .inst-note.bad {
      border-color: var(--headshot);
      color: var(--headshot);
    }

    .inst-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 22px;
    }

    .inst-actions .btn {
      flex: 1 1 200px;
    }

    @media (max-width: 640px) {
      .inst-grid {
        grid-template-columns: 1fr;
      }

      .inst-actions {
        flex-direction: column;
      }
    }
  </style>
</head>

<body>
  <div class="content vmp-auth-page">
    <div class="container-fluid">
      <div class="vmp-auth-wrap">
        <div class="row justify-content-center w-100">
          <div class="col-md-12">
            <div class="card inst-wrap">
              <div class="card-body" style="padding:28px">
                <div style="display:flex;align-items:center;gap:14px;margin-bottom:6px">
                  <div class="vmp-stat-icon"><i class="material-icons">rocket_launch</i></div>
                  <div>
                    <h4 class="card-title" style="margin:0">Welcome to CS2-VMPanel</h4>
                    <p class="card-category" style="margin:2px 0 0">First-boot setup — connect the database
                      and create the admin account.</p>
                  </div>
                </div>
                <% if (typeof error !== 'undefined' && error) { %>
                  <div class="inst-note bad show" role="alert">
                    <i class="material-icons" aria-hidden="true">error</i>
                    <span><%= error %></span>
                  </div>
                <% } %>
                <div class="inst-note" id="connOk" role="status" aria-live="polite">
                  <i class="material-icons" aria-hidden="true">check_circle</i>
                  <span></span>
                </div>
                <form method="post" action="/install" id="installForm" autocomplete="off" novalidate>
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                  <div class="inst-grid">
                    <div class="inst-section">Database</div>
                    <div class="form-group">
                      <label class="vmp-field-label" for="db_host">DB host</label>
                      <input id="db_host" name="db_host" class="form-control" required
                        value="<%= (typeof values !== 'undefined' && values.db_host) || '' %>" placeholder="localhost"
                        autocomplete="off" spellcheck="false">
                    </div>
                    <div class="form-group">
                      <label class="vmp-field-label" for="db_port">DB port</label>
                      <input id="db_port" name="db_port" class="form-control" required inputmode="numeric"
                        value="<%= (typeof values !== 'undefined' && values.db_port) || '3306' %>" placeholder="3306"
                        autocomplete="off">
                    </div>
                    <div class="form-group">
                      <label class="vmp-field-label" for="db_user">DB user</label>
                      <input id="db_user" name="db_user" class="form-control" required
                        value="<%= (typeof values !== 'undefined' && values.db_user) || '' %>" placeholder="vmpanel"
                        autocomplete="username">
                    </div>
                    <div class="form-group">
                      <label class="vmp-field-label" for="db_password">DB password</label>
                      <input id="db_password" name="db_password" class="form-control" type="password" value=""
                        placeholder="••••••••" autocomplete="new-password">
                    </div>
                    <div class="form-group full">
                      <label class="vmp-field-label" for="db_name">DB name</label>
                      <input id="db_name" name="db_name" class="form-control" required
                        value="<%= (typeof values !== 'undefined' && values.db_name) || '' %>" placeholder="vmpanel"
                        autocomplete="off" spellcheck="false">
                    </div>

                    <div class="inst-section">Admin account</div>
                    <div class="form-group">
                      <label class="vmp-field-label" for="admin_username">Username</label>
                      <input id="admin_username" name="admin_username" class="form-control" required minlength="3"
                        maxlength="32" value="<%= (typeof values !== 'undefined' && values.admin_username) || '' %>"
                        placeholder="admin" autocomplete="username">
                    </div>
                    <div class="form-group">
                      <label class="vmp-field-label" for="admin_password">Password (min 8)</label>
                      <input id="admin_password" name="admin_password" class="form-control" type="password" required
                        minlength="8" placeholder="••••••••" autocomplete="new-password">
                    </div>
                    <div class="form-group full">
                      <label class="vmp-field-label" for="admin_password_confirm">Confirm password</label>
                      <input id="admin_password_confirm" name="admin_password_confirm" class="form-control"
                        type="password" required minlength="8" placeholder="••••••••" autocomplete="new-password">
                    </div>

                    <div class="inst-section">Optional</div>
                    <div class="form-group">
                      <label class="vmp-field-label" for="steam_api_key">Steam API key</label>
                      <input id="steam_api_key" name="steam_api_key" class="form-control"
                        value="<%= (typeof values !== 'undefined' && values.steam_api_key) || '' %>"
                        placeholder="Empty = Steam login off" autocomplete="off" spellcheck="false">
                    </div>
                    <div class="form-group">
                      <label class="vmp-field-label" for="public_base_url">Public address</label>
                      <input id="public_base_url" name="public_base_url" class="form-control"
                        value="<%= (typeof values !== 'undefined' && values.public_base_url) || '' %>"
                        placeholder="Empty = auto-detect" autocomplete="off" spellcheck="false">
                    </div>
                  </div>
                  <div class="inst-actions">
                    <button type="button" class="btn btn-default" id="testBtn">
                      <i class="material-icons" aria-hidden="true">wifi_tethering</i> Test connection
                    </button>
                    <button type="submit" class="btn btn-primary" id="installBtn">
                      <i class="material-icons" aria-hidden="true">check</i> Install &amp; continue
                    </button>
                  </div>
                  <p class="vmp-hint">You will be sent to the login page when the install finishes. The wizard
                    writes <code>config.json</code> (mode <code>0600</code>) and nothing else — a legacy
                    <code>.env</code> is still read if you have one, and takes precedence.</p>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var form = document.getElementById('installForm');
      var testBtn = document.getElementById('testBtn');
      var installBtn = document.getElementById('installBtn');
      var okBox = document.getElementById('connOk');
      var okText = okBox ? okBox.querySelector('span') : null;
      var okIcon = okBox ? okBox.querySelector('.material-icons') : null;
      var lastTest = 0;

      function csrf() {
        var m = document.querySelector('meta[name="csrf-token"]');
        return m ? m.getAttribute('content') : '';
      }

      function note(kind, text) {
        if (!okBox) return;
        okBox.className = 'inst-note show ' + kind;
        if (okIcon) okIcon.textContent = kind === 'ok' ? 'check_circle' : 'error';
        if (okText) okText.textContent = text;
      }

      function collect() {
        return {
          db_host: document.getElementById('db_host').value,
          db_port: document.getElementById('db_port').value,
          db_user: document.getElementById('db_user').value,
          db_password: document.getElementById('db_password').value,
          db_name: document.getElementById('db_name').value,
          _csrf: csrf()
        };
      }

      testBtn.addEventListener('click', function () {
        var now = Date.now();
        // Ignore accidental double-clicks; the server rate-limits probes anyway.
        if (now - lastTest < 3000) return;
        lastTest = now;
        if (okBox) okBox.className = 'inst-note';
        testBtn.disabled = true;
        testBtn.textContent = 'Testing…';
        fetch('/install/test-connection', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf() },
          body: JSON.stringify(collect())
        })
          .then(function (r) { return r.json().then(function (b) { return { s: r.ok, b: b }; }); })
          .then(function (r) {
            if (r.s && r.b && r.b.success) {
              note('ok', 'Connection successful.');
            } else {
              note('bad', (r.b && r.b.data && r.b.data.message) || 'Could not connect to the database.');
            }
          })
          .catch(function () { note('bad', 'Could not connect to the database.'); })
          .finally(function () {
            testBtn.disabled = false;
            testBtn.textContent = 'Test connection';
          });
      });

      form.addEventListener('submit', function () {
        // Let the browser's own validation run first: with novalidate off we
        // let required/minlength stand, but never block a valid submit.
        installBtn.disabled = true;
        installBtn.textContent = 'Installing…';
      });
    })();
  </script>
</body>

</html>
