<%- include('Header.ejs') %>

<div class="content">
  <div class="container-fluid">
    <div class="row">

      <div class="col-md-12">
        <div class="card">
          <div class="card-header row align-items-center">
            <div class="col-lg-5 col-md-12">
              <p class="eyebrow">Oversight</p>
              <h4 class="card-title" id="manageCardTitle">Audit log</h4>
              <p class="card-category">Every admin action and automated job, newest first.</p>
            </div>
            <div class="col-lg-4 col-md-12">
              <div class="vmp-searchbar">
                <input type="text" class="form-control" placeholder="Quick-find in this page…" data-table-filter="#auditrecords" aria-label="Quick-find audit entries on this page">
              </div>
            </div>
            <div class="col-lg-2 col-md-6">
              <div class="form-group bmd-form-group mt-0 pt-0" style="margin-bottom:0 !important">
                <label class="sr-only" for="recordsPerPage">Records per page</label>
                <select class="form-control" id="recordsPerPage" onchange="recordPerPageChanged()" required>
                  <option value="10" selected>10 / page</option>
                  <option value="15">15 / page</option>
                  <option value="20">20 / page</option>
                </select>
              </div>
            </div>
            <div class="col-lg-1 col-md-6">
              <nav aria-label="Audit pages">
                <ul class="pagination justify-content-end" id="paginationUL">
                </ul>
              </nav>
            </div>
          </div>
          <div class="card-body">
            <div class="table-responsive scroller" style="max-height:600px;overflow: auto;" id="style-4">
              <table class="table vmp-table-compact" id="auditrecords">
                <thead>
                  <tr>
                  <th scope="col">Activity</th>
                  <th scope="col">Details</th>
                  <th scope="col">Performed by</th>
                  <th scope="col">Time</th>
                  </tr>
                </thead>
                <tbody id="auditLogsBody">
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('Footer.ejs') %>

<script src="./js/notifications.js"></script>
<script src="./js/panelAduitLog.js"></script>