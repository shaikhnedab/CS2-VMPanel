# ==== LEGACY .env support (existing installs keep working untouched) ====
# New installs use config.json instead (copy app/config/example_config.json
# to config.json; the /install wizard fills it in). Anything set here still
# overrides config.json values.
# ==== Setup ====
# Set to true by the first-boot wizard (/install). Keep false until installed.
SETUP_COMPLETE=false

# ==== Database ====
DB_HOST=localhost
DB_PORT=3306
DB_USER=vmpanel
DB_PASSWORD=change-me-strong
DB_NAME=vmpanel

# ==== Panel network ====
HOSTNAME=localhost
SERVER_PORT=3535
APACHE_PROXY=false
PORT=3535
# Canonical public address for Steam login callbacks, e.g. https://vip.example.com
# or http://host:3535. Empty = auto-detect from each request (recommended).
PUBLIC_BASE_URL=

# ==== Secrets (min 32 chars, never commit real values) ====
JWT_SECRET=change-me-min-32-chars-jwt-secret-please
APP_SESSION_SECRET=change-me-min-32-chars-session-secret
# Hour intervals for cron jobs
SCHEDULE_DELETE_HOURS=12
SCHEDULE_NOTIF_HOURS=24

# ==== Steam ====
# Leave empty to disable Steam login
STEAM_API_KEY=

# ==== Payments ====
PAYPAL_CLIENT_ID=
PAYU_ENABLED=false
PAYU_ENV=test
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
RAZORPAY_ENABLED=false
RAZORPAY_ENV=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ==== Logging ====
LOG_LEVEL=INFO

# ==== Table names (override only if you renamed tables) ====
USERS_TABLE=tbl_users
SETTINGS_TABLE=tbl_settings
SERVERS_TABLE=tbl_servers
SALES_TABLE=tbl_sales
AUDIT_TABLE=tbl_audit_logs
BUNDLES_TABLE=tbl_bundles
BUNDLE_REL_TABLE=tbl_rel_bundle_server
